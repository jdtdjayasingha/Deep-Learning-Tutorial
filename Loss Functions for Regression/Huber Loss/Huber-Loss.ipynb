   "metadata": {},
   "outputs": [],
   "source": [
    "y_true = [0.0, 0.5, 0.7, 1.0]\n",
    "y_pred = [0.2, 0.3, 0.9, 0.7]"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "id": "5e3869ac-a906-4192-acd1-31fcc1ba7a60",
   "metadata": {},
   "outputs": [],
   "source": [
    "huber = tf.keras.losses.Huber(delta=0.25)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "id": "9980d466-293d-4ced-820b-0cbf01151fca",
   "metadata": {},
   "outputs": [],
   "source": [
    "result = huber(y_true, y_pred).numpy()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 6,
   "id": "613bf801-aff6-46fb-a962-531268014526",
